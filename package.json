{
 "name": "vue-engine",
 "productName": "Vue Engine",
 "version": "1.8.0",
 "description": "Vue Engine - 2D game creation engine with blocks, event sheets and typed code",
 "main": "main.js",
 "author": "NexARC",
 "license": "MIT",
 "scripts": {
  "start": "electron .",
  "test": "node test/engine.test.js && node test/features.test.js && node test/vwr.test.js && node test/ext.test.js && node test/zip.test.js && node test/player.test.js && node test/events.test.js && node test/behaviors.test.js && node test/mcp.test.js && node test/assistant.test.js && node test/lib.test.js && node test/help.test.js",
  "dist": "electron-builder --win portable --publish never",
  "build:info": "node tools/build-info.js",
  "build:icons": "node tools/build-icons.js",
  "build:vwr": "sh vwr/build.sh"
 },
 "dependencies": {
  "@fontsource/inter": "^5.1.0",
  "@fontsource/jetbrains-mono": "^5.1.1",
  "blockly": "11.2.2",
  "monaco-editor": "0.52.2",
  "three": "^0.149.0",
  "typescript": "5.6.3"
 },
 "devDependencies": {
  "@phosphor-icons/core": "^2.1.1",
  "electron": "33.2.1",
  "electron-builder": "25.1.8"
 },
 "build": {
  "appId": "dev.nexarc.vueengine",
  "productName": "Vue Engine",
  "directories": {
   "output": "dist"
  },
  "files": [
   "main.js",
   "preload.js",
   "zipper.js",
   "src/**",
   "build/icon.ico",
   "node_modules/**/*",
   "!**/*.map",
   "!node_modules/monaco-editor/{esm,dev,min-maps}/**",
   "!node_modules/three/src/**",
   "!node_modules/three/examples/**",
   "!vwr/**"
  ],
  "win": {
   "target": [
    "portable"
   ],
   "icon": "build/icon.ico",
   "artifactName": "VueEngine.exe"
  },
  "portable": {
   "artifactName": "VueEngine.exe"
  }
 }
}
